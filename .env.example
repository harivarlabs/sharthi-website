# Waitlist sign-ups go to the first of these that works:
#
# 1. Email via Resend (installed from the Vercel Marketplace; the key is added to the Vercel project
#    automatically and pulled into .env.local with `vercel env pull`).
RESEND_API_KEY=
# Where to send them (default: info@sharthi.online) and the sender (default: waitlist@sharthi.online —
# the domain must be verified in Resend before this sender works).
WAITLIST_TO=
WAITLIST_FROM=
#
# 2. The team's own mailbox over SMTP (used when Resend can't send, e.g. before the domain is verified).
#    Zoho Mail India: host smtp.zoho.in, port 465, user = the mailbox, pass = an app-specific password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# 3. A webhook: each entry is POSTed as JSON {name, email, phone, interest, at}.
WAITLIST_WEBHOOK_URL=
#
# 4. Outside production, if nothing above worked: entries are appended to data/waitlist.jsonl.
