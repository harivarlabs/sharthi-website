# Waitlist sign-ups go to the first of these that works:
#
# 1. Email via Resend (installed from the Vercel Marketplace; the key is added to the Vercel project
#    automatically and pulled into .env.local with `vercel env pull`).
RESEND_API_KEY=
# Where to send them (default: info@sarathi.online) and the sender (default: waitlist@sarathi.online —
# the domain must be verified in Resend before this sender works).
WAITLIST_TO=
WAITLIST_FROM=
#
# 2. A webhook: each entry is POSTed as JSON {name, email, phone, interest, at}.
WAITLIST_WEBHOOK_URL=
#
# 3. Outside production, if nothing above worked: entries are appended to data/waitlist.jsonl.
